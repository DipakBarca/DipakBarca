rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The whole website's stock list and notice live in one document: site/main.
    match /site/main {
      // Anyone can see the stock list.
      allow read: if true;

      // Only these Google accounts can change it.
      // Keep this list the same as ADMIN_EMAILS in site/js/config.js.
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'mahato.d8877@gmail.com'
        ];
    }

    // Nothing else in the database is readable or writable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
